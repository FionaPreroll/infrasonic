# Settings for compose.yml and compose.tailscale.yml. Copy to .env next to them and adjust;
# docker compose reads .env from the directory it runs in.

# Image tag: latest (latest release) or snapshot (follows main).
INFRASONIC_TAG=latest

# Server address filled in on the login page; leave empty to type it in. The browser fetches
# from it directly, so use an address the browser reaches. A player served over HTTPS
# (compose.tailscale.yml) needs a server reachable over HTTPS.
INFRASONIC_SERVER=http://192.168.1.10:4533

# compose.yml: port on this machine.
INFRASONIC_PORT=8080

# compose.tailscale.yml: auth key from the Tailscale admin console, the machine name in the
# tailnet (the player is then at https://<name>.<tailnet>.ts.net), and whether the key is
# only used when the state volume has no login yet.
TS_AUTHKEY=
TS_HOSTNAME=infrasonic
TS_AUTH_ONCE=true
